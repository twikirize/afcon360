# AFCON360 Production Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SECURITY KEYS (REQUIRED)
# =============================================================================
SECRET_KEY=your-super-secret-key-here-min-32-chars
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the exact same independent value on every web and worker node and keep
# it stable for every booking signed with it. Production startup rejects a
# missing, short, placeholder, or SECRET_KEY-reused value. Never commit the real key.
REFUND_POLICY_SIGNING_KEY=
# ENCRYPTION_KEY must remain stable and identical on every web/worker process
# that reads encrypted database settings. Do not rotate it casually.
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-here-min-32-chars

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=afcon360_prod
DB_USER=postgres
DB_PASS=your-secure-database-password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_DIR=/var/backups/afcon360

# Optional private OCI Object Storage replica for completed database/files
# backups. Leave disabled until a private bucket and dedicated least-privilege
# OCI Customer Secret Key have been provisioned. Never commit real values.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
BACKUP_OFFSITE_PREFIX=afcon360/backups
BACKUP_OFFSITE_ENVIRONMENT=production

# Staging-only restore drill target. Do not set this to the production DB.
# BACKUP_RESTORE_TEST_DATABASE=afcon360_restore_test_staging
# BACKUP_RESTORE_TEST_PGHOST=127.0.0.1
# BACKUP_RESTORE_TEST_PGPORT=5432
# BACKUP_RESTORE_TEST_PGUSER=afcon_restore_test
# BACKUP_RESTORE_TEST_PGPASSWORD=
# BACKUP_RESTORE_CONFIRMATION=RESTORE_ONLY_TO_DISPOSABLE_TEST_DATABASE

S3_BUCKET=your-backup-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# =============================================================================
# PAYMENT PROVIDERS
# =============================================================================
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# =============================================================================
# EMAIL CONFIGURATION — LEGACY ENVIRONMENT FALLBACK ONLY
# The canonical SMTP provider is configured by Owner/Super Admin at
# /owner/communication-settings and encrypted in PostgreSQL. Once that row
# exists, it is authoritative for both web and Celery. These MAIL_* values
# are used only until the Owner-managed provider row is created.
# Never commit real credentials to this file or Git.
# =============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=AFCON360 <noreply@afcon360.com>

# =============================================================================
# SMS PROVIDER
# =============================================================================
# SMS/WhatsApp is disabled until a provider is configured and tested.
# Set SMS_DELIVERY_ENABLED=true only after secure credential setup is complete.
SMS_DELIVERY_ENABLED=false
# Provider credentials are intentionally omitted from this example file.

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_PASSWORD=your-grafana-password
PROMETHEUS_URL=http://localhost:9090

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
FLASK_ENV=production
DEBUG=false
# Keep false during owner enrollment; enable after every active owner has TOTP MFA.
# The persistent Owner Settings control is authoritative once saved.
REQUIRE_OWNER_MFA=false
SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# WALLET SETTINGS
# =============================================================================
WALLET_ENABLED=true
MAX_TRANSACTION_AMOUNT=10000000
DAILY_TRANSACTION_LIMIT=50000000

# =============================================================================
# COMPLIANCE SETTINGS
# =============================================================================
AML_ENABLED=true
KYC_REQUIRED=true
TRAVEL_RULE_ENABLED=true
COMPLIANCE_EMAIL=compliance@afcon360.com

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/afcon360.log

# =============================================================================
# ENHANCED SECURITY SETTINGS
# =============================================================================
# MFA Settings
MFA_BACKUP_CODES_COUNT=10
MFA_TOTP_WINDOW=1

# KYC Settings
KYC_ENHANCED_RISK_ASSESSMENT=true
KYC_EXPIRY_WARNING_DAYS=30
KYC_AUTO_EXPIRY_CHECK=true

# Session Management
SESSION_ROTATION_MINUTES=15
SESSION_INTEGRITY_CHECK=true

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_COUNT=5
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true