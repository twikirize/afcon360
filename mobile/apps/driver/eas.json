{
  "cli": {
    "version": ">= 17.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "driver-preview"
    },
    "production": {
      "distribution": "store",
      "channel": "driver-production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "apk-share": {
      "distribution": "internal",
      "channel": "driver-preview",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
