{
  "cli": {
    "version": ">= 17.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "AFCON360_PREVIEW_BUILD": "true",
        "AFCON360_RELEASE_BUILD": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "AFCON360_PREVIEW_BUILD": "true",
        "AFCON360_RELEASE_BUILD": "false"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "credentialsSource": "remote",
      "env": {
        "AFCON360_PREVIEW_BUILD": "false",
        "AFCON360_RELEASE_BUILD": "true"
      }
    },
    "apk-share": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "AFCON360_PREVIEW_BUILD": "true",
        "AFCON360_RELEASE_BUILD": "false"
      }
    },
    "dev-apk": {
      "distribution": "internal",
      "channel": "user-development",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "AFCON360_PREVIEW_BUILD": "true",
        "AFCON360_RELEASE_BUILD": "false",
        "AFCON360_UPDATE_CHANNEL": "user-development",
        "EXPO_PUBLIC_API_BASE_URL": "https://www.pamoja.space"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
