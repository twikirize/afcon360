# ============================================================================
# AFCON 360 — .env.docker  (Docker Compose only)
# ============================================================================
# Overrides base .env for Docker.
# Uses Docker service names (db, redis) as hostnames — NOT localhost.
# CRITICAL: @ in Redis password is percent-encoded as %40 in URLs.
# ============================================================================

APP_ENV=docker
FLASK_ENV=production
LOG_LEVEL=WARNING

# Database — Docker service name "db"
DB_HOST=db
DATABASE_URL=postgresql://israeli:Israelipass@db:5432/afcon360_prod

#eenvironment domain to nbe set once the website is set up
PUBLIC_BASE_URL=https://your-domain.com

# Redis — Docker service name "redis"
# Raw password: Muhereza@1993  →  encoded in URL as Muhereza%401993
REDIS_URL=redis://:Muhereza%401993@redis:6379/0
CELERY_BROKER_URL=redis://:Muhereza%401993@redis:6379/0
CELERY_RESULT_BACKEND=redis://:Muhereza%401993@redis:6379/1

