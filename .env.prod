# ============================================================================
# AFCON 360 — .env.prod  (Oracle Cloud)
# ============================================================================
# Overrides base .env for production.
#
# TWO DEPLOYMENT MODES — uncomment the block that matches your Oracle setup:
#
#   MODE A: Docker-on-VM  (Postgres runs as a Docker container named "db")
#   MODE B: Native-on-VM  (Postgres runs directly on the Oracle VM at 127.0.0.1)
#
# Only ONE block should be active at a time.
# ============================================================================

APP_ENV=prod
FLASK_ENV=production
LOG_LEVEL=WARNING

PUBLIC_BASE_URL=https://your-domain.com

# ----------------------------------------------------------------------------
# MODE A — Docker-on-VM  (default — Postgres in Docker container)
# DB_HOST uses Docker service name "db" as hostname
# ----------------------------------------------------------------------------
DB_HOST=db
DATABASE_URL=postgresql://israeli:Israelipass@db:5432/afcon360_prod

# ----------------------------------------------------------------------------
# MODE B — Native Postgres on Oracle VM  (uncomment and comment out MODE A)
# Use 127.0.0.1 — NOT localhost — to force TCP and avoid socket path issues
# ----------------------------------------------------------------------------
# DB_HOST=127.0.0.1
# DATABASE_URL=postgresql://israeli:Israelipass@127.0.0.1:5432/afcon360_prod

# Redis — same encoding rule: @ in password encoded as %40
# Raw password: Muhereza@1993
REDIS_URL=redis://:Muhereza%401993@redis:6379/0
CELERY_BROKER_URL=redis://:Muhereza%401993@redis:6379/0
CELERY_RESULT_BACKEND=redis://:Muhereza%401993@redis:6379/1

# Real secrets — live here, NOT in base .env
SECRET_KEY=ajT3Udt0ig7Zn1AaEIqPOzbxspfzehnoIFzrt7XR2JpRjMXXFwhv28t6i7iryWWtIlrgTUphHqVJ_e1TLt_aIw
SECURITY_SALT=xWUJ7bXWs_rvRmOYJAWacHYisGA8XKgYGsp7MegWI16RbtU1wqekLmGDqCMScMB6i4YmOSS5QCgJ2E50QqkUUw
ENCRYPTION_KEY=hMT_N5BjMr0jq3SQsLK03nTKXSnLbPcEJ8Kkbp4hTzw
QR_SECRET_KEY=AQZl01FAYA0tyl9mZxXNnmWJJxdsSEwJitbnDPCz6_o
MFA_ENCRYPTION_KEY=mfa-afcon360-secure-key-prod-2026!
DEEPSEEK_API_KEY=sk-e9d8491b0a3a4a3fbe08352da9e05894

# Secure cookie required in production (HTTPS only)
SESSION_COOKIE_SECURE=true

# Increase Celery workers for production load
CELERY_CONCURRENCY=4


STORAGE_TYPE=oci
OCI_NAMESPACE=your-tenancy-namespace
OCI_BUCKET_NAME=afcon360-media
OCI_REGION=eu-frankfurt-1
OCI_ACCESS_KEY=your-oci-access-key
OCI_SECRET_KEY=your-oci-secret-key
OCI_ENDPOINT_URL=https://your-namespace.compat.objectstorage.eu-frankfurt-1.oraclecloud.com
#CDN_BASE_URL=https://cdn.afcon360.com  # optional — if you set up a CDN
