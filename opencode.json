{
  "$schema": "https://opencode.ai/config.json",

  "shell": "pwsh",

  "instructions": [
    ".opencode/rules/afcon360-constitution.md",
    ".opencode/rules/clarification-protocol.md"
  ],

  "permission": {
    "edit": "ask",
    "write": {
      "**/migrations/versions/*.py": "deny",
      "**/alembic/**/*.py": "deny",
      "**/app/wallet/models/*.py": "deny",
      "**/app/models/base.py": "deny",
      "**/*": "allow"
    },
    "bash": "allow"
  },

  "agent": {
    "afcon360-dev": {
      "description": "AFCON360 constitutional developer - locked files require clarification",
      "prompt": "You are an AFCON360 developer operating under the AFCON360 Agent Constitution (AGENTS.md). Follow Evidence-Gated Graph Engineering: UNDERSTAND → MAP → TRACE → PROVE → MINIMAL CHANGE → VERIFY → GATE → RECORD → NEXT. Never bypass locked files, ownership boundaries, wallet protections, migration authorization, or clarification protocol.",
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "task": true
      }
    }
  },

  "mcp": {

    "afcon360-files": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\OBED\\Desktop\\afcon360_app"
      ],
      "enabled": true
    },

    "afcon360-git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "C:\\Users\\OBED\\Desktop\\afcon360_app"
      ],
      "enabled": true
    },

    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },

    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp"
      ],
      "enabled": true
    },

    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },

    "postgres-test": {
      "type": "local",
      "command": [
        "<POSTGRES_TEST_MCP_COMMAND>"
      ],
      "enabled": false
    },

    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": false
    },

    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": false
    },

    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": false
    },

    "mcp-everything": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-everything"
      ],
      "enabled": false
    },

    "time": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-time"
      ],
      "enabled": false
    },

    "sentry": {
      "type": "remote",
      "url": "<SENTRY_MCP_URL>",
      "enabled": false
    },

    "oracle-cloud": {
      "type": "remote",
      "url": "<ORACLE_CLOUD_MCP_URL>",
      "enabled": false
    },

    "cloudflare": {
      "type": "remote",
      "url": "<CLOUDFLARE_MCP_URL>",
      "enabled": false
    },

    "afcon360": {
      "type": "local",
      "command": [
        "<AFCON360_CUSTOM_MCP_COMMAND>"
      ],
      "enabled": false
    }
  }
}